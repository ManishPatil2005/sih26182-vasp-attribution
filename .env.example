# ==============================================================================
# CRIMEGRAPH AI - Environment Configuration Template
# Ministry of Home Affairs (NCRB) - Problem Statement 26189
# ==============================================================================

# --- Application Core ---
APP_ENV=development
APP_NAME=CrimeGraph-AI
APP_VERSION=1.0.0
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# --- Security & Cryptography ---
# Use 64+ char random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUDIT_LOG_SALT=secure-salt-for-bsa2023-tamper-evident-chain

# --- Knowledge Graph Engine ---
# Set GRAPH_ENGINE=hybrid (NetworkX in-memory cache + Neo4j persistent sync)
# For quick demo/evaluation without Docker, set GRAPH_ENGINE=inmemory
GRAPH_ENGINE=hybrid
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supersecretpassword

# --- Entity Resolution & AI Pipelines ---
SPLINK_MATCH_THRESHOLD=0.85
SPLINK_REVIEW_THRESHOLD=0.60
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TESSERACT_CMD=tesseract

# --- Audit & Legal Compliance (BSA 2023 Section 63) ---
ENABLE_TAMPER_EVIDENT_CHAIN=True
AUDIT_LEDGER_PATH=./data/audit_ledger.json
OFFICER_STATION_CODE=MHA-NCRB-HQ-01

# --- Frontend Connection ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
