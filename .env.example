# ==============================================================================
# SAHYOG-VASP AI - Environment Configuration Template
# Ministry of Home Affairs (I4C) - Problem Statement SIH26182
# "Automated Attribution of Unknown Wallets to Nearest VASPs via Blockchain APIs"
# ==============================================================================

# --- Application Core ---
APP_ENV=development
APP_NAME=SAHYOG-VASP-AI
APP_VERSION=3.0.0
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173

# --- Security & Cryptography ---
# Use 64+ char random secret in production (e.g. openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUDIT_LOG_SALT=secure-salt-for-bsa2023-tamper-evident-chain

# --- Blockchain Intelligence Gateway API Keys (Optional Live Connectors) ---
# When omitted, the engine falls back to high-fidelity on-chain deterministic heuristics
TRONSCAN_API_KEY=
ETHERSCAN_API_KEY=
BLOCKSTREAM_API_KEY=
SOLSCAN_API_KEY=
ALCHEMY_API_KEY=

# --- Knowledge Graph Engine ---
# Set GRAPH_ENGINE=hybrid (NetworkX in-memory cache + persistent sync)
# For quick demo/evaluation without Docker, set GRAPH_ENGINE=inmemory
GRAPH_ENGINE=hybrid
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=supersecretpassword

# --- MHA SAHYOG & I4C 1930 Integration Boundary ---
SAHYOG_API_ENDPOINT=https://sahyog.gov.in/api/v2
SAHYOG_CLIENT_ID=I4C-DELHI-CYBER-CELL
SAHYOG_CLIENT_SECRET=change-in-production-for-sahyog-mtls
HELPLINE_1930_FEED_ENABLED=True

# --- Audit & Legal Compliance (BSA 2023 Section 63 & BNSS Section 94) ---
ENABLE_TAMPER_EVIDENT_CHAIN=True
AUDIT_LEDGER_PATH=./data/audit_ledger.json
OFFICER_STATION_CODE=MHA-I4C-HQ-01

# --- Frontend Connection ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
